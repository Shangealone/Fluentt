!speech-workers/wav2vec2/requirements.lock
!speech-workers/wav2vec2/NOTICE.md
!speech-workers/wavlm/
!speech-workers/wavlm/*.py
!speech-workers/wavlm/Dockerfile
!speech-workers/wavlm/requirements.lock
!speech-workers/wavlm/NOTICE.md
