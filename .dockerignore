# The root-context Dockerfiles build only the optional speech workers.
**
!backend/
!backend/app/
!backend/app/__init__.py
!backend/app/speech/
!backend/app/speech/*.py
!speech-workers/
!speech-workers/common.py
!speech-workers/wav2vec2/
!speech-workers/wav2vec2/*.py
