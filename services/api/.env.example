FLUENTT_ENVIRONMENT=development
FLUENTT_CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]
FLUENTT_LOG_LEVEL=INFO
# Optional for application health; required for online database operations/migrations.
# Set your local credentials in an ignored .env file; URL-encode reserved characters.
# FLUENTT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/fluentt
FLUENTT_DATABASE_POOL_SIZE=5
FLUENTT_DATABASE_MAX_OVERFLOW=5
FLUENTT_DATABASE_POOL_TIMEOUT=10
FLUENTT_DATABASE_CONNECT_TIMEOUT=5
FLUENTT_MOBILE_SESSION_IDLE_DAYS=30
FLUENTT_MOBILE_SESSION_ABSOLUTE_DAYS=90
# Per-peer, per-process fixed-window limits. Use global edge limits before scaling workers.
FLUENTT_IDENTITY_RATE_WINDOW_SECONDS=60
FLUENTT_USERNAME_CHECK_LIMIT=30
FLUENTT_USER_CREATION_LIMIT=10
FLUENTT_MOBILE_SESSION_REQUEST_LIMIT=60
# Tests create a fresh UUID-named DB using a maintenance connection with CREATEDB.
# Set FLUENTT_TEST_DATABASE_URL in the shell only (not this settings .env).
FLUENTT_CLASS_CREATION_LIMIT=10
