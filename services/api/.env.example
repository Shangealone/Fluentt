FLUENTT_ENVIRONMENT=development
FLUENTT_CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]
FLUENTT_LOG_LEVEL=INFO
# Optional for application health; required for online database operations/migrations.
# Set your local credentials in an ignored .env file; URL-encode reserved characters.
# FLUENTT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/fluentt
FLUENTT_DATABASE_POOL_SIZE=5
FLUENTT_DATABASE_MAX_OVERFLOW=5
FLUENTT_DATABASE_POOL_TIMEOUT=10
FLUENTT_DATABASE_CONNECT_TIMEOUT=5
FLUENTT_MOBILE_SESSION_IDLE_DAYS=30
FLUENTT_MOBILE_SESSION_ABSOLUTE_DAYS=90
# Per-peer, per-process fixed-window limits. Use global edge limits before scaling workers.
FLUENTT_IDENTITY_RATE_WINDOW_SECONDS=60
FLUENTT_USERNAME_CHECK_LIMIT=30
FLUENTT_USER_CREATION_LIMIT=10
FLUENTT_MOBILE_SESSION_REQUEST_LIMIT=60
# Tests create a fresh UUID-named DB using a maintenance connection with CREATEDB.
# Set FLUENTT_TEST_DATABASE_URL in the shell only (not this settings .env).
FLUENTT_CLASS_CREATION_LIMIT=10
# Preview + confirmation budgets share the same window; process-local, not distributed.
FLUENTT_ENROLLMENT_PEER_LIMIT=60
FLUENTT_ENROLLMENT_SESSION_LIMIT=10
# Section 08: sign-in stays disabled until every OIDC field and MFA evidence is configured.
FLUENTT_ADMIN_WEB_ORIGIN=http://localhost:3000
FLUENTT_ADMIN_AUTH_LIMIT=10
# FLUENTT_ADMIN_OIDC_ISSUER=https://YOUR-APPROVED-ISSUER
# FLUENTT_ADMIN_OIDC_CLIENT_ID=YOUR-REGISTERED-CONFIDENTIAL-CLIENT
# Set the actual secret only in ignored local configuration / deployment secret management.
# FLUENTT_ADMIN_OIDC_CLIENT_SECRET=
FLUENTT_ADMIN_OIDC_MFA_CLAIM=acr
FLUENTT_ADMIN_OIDC_MFA_VALUES=[]

# Optional personal English whole-sentence pronunciation assessment. Disabled by default.
# Review applicable audio-processing permissions/terms before enabling. This reference is
# deployment evidence, not permission granted by a toggle. No research collection is enabled.
FLUENTT_PRONUNCIATION_AZURE_ENABLED=false
# Resource name only, not a URL. Put a real key only in ignored .env / secret management.
# FLUENTT_PRONUNCIATION_AZURE_RESOURCE=your-speech-resource
# FLUENTT_PRONUNCIATION_AZURE_KEY=
# FLUENTT_PRONUNCIATION_CLOUD_AUTHORIZATION_REFERENCE=approved-audio-processing-reference
