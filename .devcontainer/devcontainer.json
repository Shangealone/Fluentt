{
  "name": "FLUENTT WavLM demo",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "FLUENTT synthetic WavLM demo",
      "onAutoForward": "notify"
    }
  }
}
