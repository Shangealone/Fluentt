APP_ENV=development
DATABASE_URL=postgresql+psycopg://fluentt:fluentt_dev_only@localhost:5432/fluentt
JWT_SECRET=replace-with-a-random-development-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Pronunciation: supply real Azure values locally; never commit credentials.
AZURE_SPEECH_KEY=
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_REGION=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Optional private cache directory; otherwise uses the operating-system temp folder.
PRONUNCIATION_TEMP_ROOT=
