APP_ENV=development
DATABASE_URL=postgresql+psycopg://fluentt:fluentt_dev_only@localhost:5432/fluentt
JWT_SECRET=replace-with-a-random-development-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Optional private model workers. Candidate output is internal QA only.
SPEECH_RECOGNITION_ENABLED=false
SPEECH_ASSESSMENT_ENABLED=false
SPEECH_INTERNAL_QA_USER_IDS=[]
SPEECH_RECOGNITION_URL=
SPEECH_ASSESSMENT_URL=
SPEECH_SERVICE_TOKEN=
SPEECH_MAX_INFLIGHT=2
SPEECH_WORKER_TIMEOUT_SECONDS=30
